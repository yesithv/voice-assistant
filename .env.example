# Language model provider: groq (hosted, default) | ollama (local, no data leaves your machine)
LLM_PROVIDER=groq

# Groq — cloud AI inference, requires a free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — local AI inference, install from https://ollama.com and run: ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Faster-Whisper (small | medium | large-v3)
WHISPER_MODEL=small

# Piper TTS — path to the downloaded .onnx voice model
PIPER_MODEL_PATH=models/tts/en_US-lessac-medium.onnx

# Flask — signs the session cookie that stores the conversation history (random if empty)
SECRET_KEY=
PORT=8000
