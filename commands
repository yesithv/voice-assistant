# ── Virtual environment ──────────────────────────────────────────────────────
python -m venv env_voice_assistant              # create virtual environment
.\env_voice_assistant\Scripts\Activate.ps1      # activate (PowerShell)
deactivate                                      # deactivate

# ── Dependencies ─────────────────────────────────────────────────────────────
pip install -r requirements.txt          # install from requirements file
pip list                                 # verify installed packages
pip freeze > requirements.txt            # export current env to requirements

# ── Piper TTS — download voice model (one-time setup) ────────────────────────
New-Item -ItemType Directory -Force -Path models\tts
Invoke-WebRequest `
  -Uri "https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/en_US-lessac-medium.onnx" `
  -OutFile "models\tts\en_US-lessac-medium.onnx"
Invoke-WebRequest `
  -Uri "https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/en_US-lessac-medium.onnx.json" `
  -OutFile "models\tts\en_US-lessac-medium.onnx.json"
# Whisper model (small) downloads automatically from HuggingFace on first run

# ── Environment variables ─────────────────────────────────────────────────────
# Copy .env.example to .env and fill in your real values (never commit .env)
Copy-Item .env.example .env
# Required variables in .env:
#   GROQ_API_KEY     → your API key from https://console.groq.com/keys
#   GROQ_MODEL       → llama-3.3-70b-versatile (default) | any other Groq-hosted model
#   WHISPER_MODEL    → small (default) | medium | large-v3
#   PIPER_MODEL_PATH → models/tts/en_US-lessac-medium.onnx

# ── Groq — cloud AI model (one-time setup) ───────────────────────────────────
# Create a free account and API key at https://console.groq.com/keys
# Paste the key into .env as GROQ_API_KEY (no local server required)

# ── Run application ──────────────────────────────────────────────────────────
python server.py                          # web server  → http://localhost:8000
